# .env.prod  copy this file, rename to .env.prod, fill in real values, NEVER commit .env.prod
PROD_DB_PASSWORD=change_me_prod_db_password
PROD_JWT_SECRET=change_me_prod_jwt_secret_min_32_chars_long
PROD_RABBITMQ_PASSWORD=change_me_prod_rabbitmq_password
PROD_PAYSTACK_SECRET_KEY=change_me_paystack_secret_key
PROD_PAYSTACK_SHOP_CALLBACK_URL=https://app.spazasure.co.za/?payment=success
PROD_PAYSTACK_CUSTOMER_CALLBACK_URL=https://app.spazasure.co.za/?payment=success
PROD_PAYSTACK_SUPPLIER_CALLBACK_URL=https://portal.spazasure.co.za/subscription?payment=success
PROD_PAYSTACK_PLAN_CUSTOMER_PLUS_MONTHLY=
PROD_PAYSTACK_PLAN_SUPPLIER_BRONZE_MONTHLY=
PROD_PAYSTACK_PLAN_SUPPLIER_BRONZE_ANNUAL=
PROD_PAYSTACK_PLAN_SUPPLIER_SILVER_MONTHLY=
PROD_PAYSTACK_PLAN_SUPPLIER_SILVER_ANNUAL=
PROD_PAYSTACK_PLAN_SUPPLIER_GOLD_MONTHLY=
PROD_PAYSTACK_PLAN_SUPPLIER_GOLD_ANNUAL=
# Pay suppliers automatically through Paystack Transfers (needs Transfers enabled and OTP for transfers off)
PROD_PAYSTACK_AUTOMATIC_PAYOUTS=false
# Didit identity checks (in production these come from GitHub secrets; the
# endpoints report "not available" while the key is empty)
PROD_DIDIT_API_KEY=
PROD_DIDIT_WEBHOOK_SECRET=
PROD_DIDIT_SHOP_WORKFLOW_ID=
PROD_DIDIT_SUPPLIER_WORKFLOW_ID=
PROD_DIDIT_SANDBOX=false
PROD_DIDIT_SHOP_CALLBACK_URL=https://portal.spazasure.co.za/verification-complete
PROD_DIDIT_SUPPLIER_CALLBACK_URL=https://portal.spazasure.co.za/profile?verification=done
# Public address of the Gateway, used in links the services send out
PROD_PUBLIC_API_URL=https://api.spazasure.co.za
# Database backups (see DATABASE_BACKUPS.md). Without an off-site target the
# backups stay on the same server as the database.
PROD_BACKUP_RETENTION_DAYS=14
PROD_BACKUP_INTERVAL_SECONDS=86400
PROD_BACKUP_OFFSITE_TARGET=
PROD_BACKUP_OFFSITE_PORT=23
# Password-reset email (any SMTP provider: SendGrid, Brevo, Mailgun, SES, Google Workspace...)
PROD_SMTP_HOST=smtp.example.com
PROD_SMTP_PORT=587
PROD_SMTP_USERNAME=change_me_smtp_username
PROD_SMTP_PASSWORD=change_me_smtp_password
PROD_EMAIL_FROM=no-reply@spazasure.co.za
# Where replies to automated emails go (testers reply with feedback), e.g. hello@spazasure.co.za
PROD_EMAIL_REPLY_TO=
# Automated emails: welcome, feature tips, "we miss you" reminders. Off until "true".
# Brevo SMTP: host smtp-relay.brevo.com, port 587, username = your Brevo login, password = an SMTP key.
PROD_EMAIL_SEQUENCES_ENABLED=false
# "true" logs who would get which email without sending anything
PROD_EMAIL_SEQUENCES_DRY_RUN=false
# While testing, only these addresses or @domains get the sequences (empty = everyone)
PROD_EMAIL_SEQUENCES_ONLY_TO=
# Emails per day across all kinds (Brevo's free plan allows 300)
PROD_EMAIL_DAILY_LIMIT=250
REGISTRY=ghcr.io/your-org
IMAGE_TAG=latest

# CORS — the frontend domain(s) that are allowed to call the Gateway. This is
# the ONLY CORS setting that matters in production: every backend service is
# Docker-internal only (see the lack of a `ports:` mapping on any of them
# except the gateway), so the browser only ever talks to the Gateway.
PROD_FRONTEND_URL=https://app.spazasure.co.za
PROD_SUPPLIER_PORTAL_URL=https://portal.spazasure.co.za
# The admin console is a separate site from the supplier portal
PROD_ADMIN_CONSOLE_URL=https://admin.spazasure.co.za
# Object storage — compliance documents and supplier/shop logos. For a Hetzner
# deployment, local storage persists in the Docker volumes below. Set this to
# "s3" only when using an external object-storage service.
PROD_STORAGE_PROVIDER=local
# DigitalOcean Spaces example:
#   PROD_S3_SERVICE_URL=https://<region>.digitaloceanspaces.com
#   PROD_S3_REGION=<region>
#   PROD_S3_PUBLIC_URL=https://<bucket>.<region>.cdn.digitaloceanspaces.com
# PROD_S3_BUCKET_NAME=change_me_bucket_name
# PROD_S3_SERVICE_URL=change_me_s3_endpoint
# PROD_S3_REGION=auto
# PROD_S3_ACCESS_KEY=change_me_s3_access_key
# PROD_S3_SECRET_KEY=change_me_s3_secret_key
# PROD_S3_PUBLIC_URL=change_me_public_url_for_uploaded_files
