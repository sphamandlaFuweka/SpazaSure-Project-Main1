# .env.prod  copy this file, rename to .env.prod, fill in real values, NEVER commit .env.prod
PROD_DB_PASSWORD=change_me_prod_db_password
PROD_JWT_SECRET=change_me_prod_jwt_secret_min_32_chars_long
PROD_RABBITMQ_PASSWORD=change_me_prod_rabbitmq_password
PROD_AT_USERNAME=change_me_africas_talking_username
PROD_AT_API_KEY=change_me_africas_talking_live_api_key
PROD_PAYFAST_MERCHANT_ID=change_me_payfast_live_merchant_id
PROD_PAYFAST_MERCHANT_KEY=change_me_payfast_live_merchant_key
PROD_PAYFAST_PASSPHRASE=change_me_payfast_live_passphrase
PROD_PUBLIC_URL=https://example.com
REGISTRY=ghcr.io/your-org
IMAGE_TAG=latest

# CORS — the frontend domain(s) that are allowed to call the Gateway. This is
# the ONLY CORS setting that matters in production: every backend service is
# Docker-internal only (see the lack of a `ports:` mapping on any of them
# except the gateway), so the browser only ever talks to the Gateway.
PROD_FRONTEND_URL=https://app.example.com

# Object storage — compliance documents and supplier/shop logos. Render and
# Fly.io both use ephemeral filesystems, so PROD_STORAGE_PROVIDER should stay
# "s3" for either of those. Only set it to "local" if you're deploying this
# compose file to a single persistent VPS, where the prod_uploads Docker
# volume below actually survives restarts.
PROD_STORAGE_PROVIDER=s3
# Works with AWS S3, Cloudflare R2, DigitalOcean Spaces, or MinIO.
# Cloudflare R2 example:
#   PROD_S3_SERVICE_URL=https://<account-id>.r2.cloudflarestorage.com
#   PROD_S3_REGION=auto
#   PROD_S3_PUBLIC_URL=https://<your-r2-public-bucket-domain>
# DigitalOcean Spaces example:
#   PROD_S3_SERVICE_URL=https://<region>.digitaloceanspaces.com
#   PROD_S3_REGION=<region>
#   PROD_S3_PUBLIC_URL=https://<bucket>.<region>.cdn.digitaloceanspaces.com
PROD_S3_BUCKET_NAME=change_me_bucket_name
PROD_S3_SERVICE_URL=change_me_s3_endpoint
PROD_S3_REGION=auto
PROD_S3_ACCESS_KEY=change_me_s3_access_key
PROD_S3_SECRET_KEY=change_me_s3_secret_key
PROD_S3_PUBLIC_URL=change_me_public_url_for_uploaded_files
