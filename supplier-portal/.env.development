# Development Environment Configuration
# This file is used when running: npm run dev

# API Base URL - your own local backend Gateway (see SpazaSure.Backend/StartAll.ps1
# or start-all.sh). Point this at the QA server instead only if you intentionally
# want to develop the frontend against the shared QA deployment.
VITE_API_URL=http://localhost:5181/api

# App Configuration
VITE_APP_NAME=SpazaSure Supplier Portal
VITE_APP_ENV=development

# Feature Flags (optional)
VITE_ENABLE_DEBUG=true
VITE_ENABLE_MOCK_DATA=false

# Other settings
VITE_API_TIMEOUT=15000
